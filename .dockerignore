.git
.gitignore

# 前端源码目录本地依赖/产物不进入 Docker 构建上下文
ARL/docker/frontend-src/node_modules
ARL/docker/frontend-src/dist
ARL/docker/frontend-src/.vite
ARL/docker/frontend-src/.cache
ARL/docker/frontend-src/npm-debug.log*

# WIH 本地 Node 依赖由镜像构建阶段安装，避免污染构建上下文
tools/wih/node_modules
tools/wih/npm-debug.log*

# 旧版预编译前端目录不再参与镜像构建
ARL/docker/frontend

# 通用临时文件
**/__pycache__/
*.log

# Rust 构建产物只在镜像构建阶段生成，避免把本机架构产物带入上下文。
**/target/
**/*.whl
**/.cargo/
