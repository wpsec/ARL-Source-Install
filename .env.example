# ARL Docker Compose Configuration
# 复制本文件为 .env（仅本地存在，不入库）并填入自设凭据；
# <set-me> 占位值会被 start.sh 的 preflight 检查拒绝，不允许带占位符启动。
# 凭据轮换与一致性要求见 docs/reference/[长期参考]配置治理与凭据轮换.md

# ========== Nginx Reverse Proxy ==========
# Basic Auth 用户名（用户名非敏感，可保留示例值）
BASIC_AUTH_USERNAME=admin

# Basic Auth 密码（必填强密码，至少 12 个字符）
BASIC_AUTH_PASSWORD=<set-me>

# ARL 应用登录账号（仅在 Mongo 数据卷首次初始化时生效；轮换见 runbook）
ARL_APP_USERNAME=admin
ARL_APP_PASSWORD=<set-me>

# Nginx 监听端口
NGINX_LISTEN_PORT=80

# Worker 副本数（可选 1 或 2，默认建议 2）
ARL_WORKER_REPLICAS=2

# ========== MongoDB ==========
# MongoDB 初始化管理员用户名（web/worker/scheduler 数据库认证同源使用）
MONGO_INITDB_ROOT_USERNAME=admin

# MongoDB 初始化管理员密码（必填；compose 缺失即拒绝启动）
MONGO_INITDB_ROOT_PASSWORD=<set-me>

# ========== RabbitMQ ==========
# RabbitMQ 默认用户名
RABBITMQ_DEFAULT_USER=arl

# RabbitMQ 默认用户密码（必填；broker 连接串凭据由此注入，不在配置模板中存放）
RABBITMQ_DEFAULT_PASS=<set-me>

# RabbitMQ 默认虚拟主机
RABBITMQ_DEFAULT_VHOST=arlv2host

# ========== 系统配置 ==========
# 时区
TZ=Asia/Shanghai

# 语言
LANG=en_US.UTF-8

# ========== Docker 构建（可选） ==========
# Dockerfile 需要 BuildKit；quick-build.sh 会默认启用，无需手动设置。
# 网络受限时可指定可访问的 MassDNS 镜像仓库：
# ARL_MASSDNS_REPOSITORY=https://github.com/blechschmidt/massdns.git
# 或将固定 commit 源码包放入 tools/massdns/ 后指定文件名：
# ARL_MASSDNS_OFFLINE_ARCHIVE=massdns-6bfa47197d78e68b79041d494e280174cb2d6ae1.tar.gz
