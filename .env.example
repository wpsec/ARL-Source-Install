# ARL Docker Compose Configuration
# 配置分为：下方 7 个必填键、可选运行开关、可选构建镜像配置。
# 复制本文件为 .env（仅本地存在，不入库）；start.sh 会自动生成 Mongo/RabbitMQ
# 内部随机凭据，只需填写 BASIC_AUTH_PASSWORD 与 ARL_APP_PASSWORD。
# 直接使用 Docker Compose 时，仍需自行替换全部密码占位值。
# 凭据轮换与一致性要求见 docs/reference/[长期参考]配置治理与凭据轮换.md

# ========== Nginx Reverse Proxy ==========
# [可选] Basic Auth 用户名（用户名非敏感，默认 admin）
BASIC_AUTH_USERNAME=admin

# [必填] Basic Auth 密码（强密码，至少 12 个字符）
BASIC_AUTH_PASSWORD=<set-me>

# [必填] ARL 应用登录账号（仅在 Mongo 数据卷首次初始化时生效；轮换见 runbook）
ARL_APP_USERNAME=admin
# [必填] ARL 应用登录密码
ARL_APP_PASSWORD=<set-me>

# [可选] Nginx 监听端口
NGINX_LISTEN_PORT=80

# [可选] Worker 副本数（仅支持 1 或 2，默认 2）
ARL_WORKER_REPLICAS=2

# ========== MongoDB ==========
# [必填] MongoDB 初始化管理员用户名（web/worker/scheduler 数据库认证同源使用）
MONGO_INITDB_ROOT_USERNAME=admin

# [启动脚本自动生成] MongoDB 初始化管理员密码（已有值保持不变）
MONGO_INITDB_ROOT_PASSWORD=<set-me>

# ========== RabbitMQ ==========
# [必填] RabbitMQ 默认用户名
RABBITMQ_DEFAULT_USER=arl

# [启动脚本自动生成] RabbitMQ 默认用户密码（已有值保持不变）
RABBITMQ_DEFAULT_PASS=<set-me>

# ========== 计划 6 发布验收开关（可选） ==========
# 生产默认保持关闭；仅按附录 E 的同 revision 灰度流程临时覆盖。
ARL_API_UNIFIED_ENABLE=false
ARL_API_UNIFIED_FALLBACK_ENABLE=true
ARL_RUST_ACCEL_API_UNIFIED_MODE=shadow
ARL_RUST_ACCEL_API_UNIFIED_RUST_STAGES=unified_normalize,unified_method

# ========== Docker 构建（可选） ==========
# Dockerfile 需要 BuildKit；quick-build.sh 会默认启用，无需手动设置。
# 网络受限时可指定可访问的 MassDNS 镜像仓库：
# ARL_MASSDNS_REPOSITORY=https://github.com/blechschmidt/massdns.git
# 或将固定 commit 源码包放入 tools/massdns/ 后指定文件名：
# ARL_MASSDNS_OFFLINE_ARCHIVE=massdns-6bfa47197d78e68b79041d494e280174cb2d6ae1.tar.gz
# 国内网络可选：仅影响构建阶段依赖下载，不是运行必填项。
# ARL_FRONTEND_NPM_REGISTRY=https://registry.npmmirror.com
# ARL_PIP_INDEX_URL=https://pypi.mirrors.ustc.edu.cn/simple/
# ARL_PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
