# ARL Docker Compose Configuration
# 复制本文件为 .env，修改对应的配置

# ========== Nginx Reverse Proxy ==========
# Basic Auth 用户名
BASIC_AUTH_USERNAME=admin

# Basic Auth 密码（建议使用强密码，至少 12 个字符）
BASIC_AUTH_PASSWORD=admin123456

# ARL 应用登录账号（仅在 Mongo 数据卷首次初始化时生效）
ARL_APP_USERNAME=admin
ARL_APP_PASSWORD=arlpass

# Nginx 监听端口
NGINX_LISTEN_PORT=80

# Worker 副本数（可选 1 或 2，默认建议 2）
ARL_WORKER_REPLICAS=2

# ========== PoC 文库自动同步（可选） ==========
# 为了保持一键部署，系统会优先使用本地 tools/poc；缺失时可按以下配置自动补齐。
ARL_POC_AUTO_SYNC_ENABLE=1

# 文库不可用时是否阻断启动（1=阻断，0=降级继续）
# ARL_POC_REQUIRED=0

# 方案1：远程压缩包（推荐）
# ARL_POC_ARCHIVE_URL=https://example.com/arl-poc-library.tar.zst
# ARL_POC_ARCHIVE_SUBDIR=tools/poc

# 方案2：Git 仓库
# ARL_POC_GIT_REPO=https://github.com/your-org/arl-poc-library.git
# ARL_POC_GIT_REF=main
# ARL_POC_GIT_SUBDIR=tools/poc

# 判定文库有效的最小文件数（默认50）
# ARL_POC_MIN_FILES=50

# ========== MongoDB ==========
# MongoDB 初始化管理员用户名
MONGO_INITDB_ROOT_USERNAME=admin

# MongoDB 初始化管理员密码
MONGO_INITDB_ROOT_PASSWORD=admin

# ========== RabbitMQ ==========
# RabbitMQ 默认用户名
RABBITMQ_DEFAULT_USER=arl

# RabbitMQ 默认用户密码
RABBITMQ_DEFAULT_PASS=arlpassword

# RabbitMQ 默认虚拟主机
RABBITMQ_DEFAULT_VHOST=arlv2host

# ========== 系统配置 ==========
# 时区
TZ=Asia/Shanghai

# 语言
LANG=en_US.UTF-8
