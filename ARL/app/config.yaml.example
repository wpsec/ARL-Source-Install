
CELERY:
  BROKER_URL : "amqp://arl:arlpassword@localhost:5672/arlv2host"


MONGO:
  URI : 'mongodb://127.0.0.1:27017/'
  DB : 'arl'



# 利用三方API进行域名收集
# 测试命令 python3 -m test.test_query_plugin [source1] [source2]
# 域名查询插件配置, enable 字段可以单独控制是否启用该插件，如果没有这个字段也会默认启用
QUERY_PLUGIN:
  alienvault:
    enable: true
  certspotter: # https://www.certspotter.com/
    after_id: 1
    max_page: 3
    enable: true
  crtsh:
    enable: true
  fofa:  # fofa 的key配置在上面
    enable: true
  hunter_qax: # 网站 https://hunter.qianxin.com/
    api_key: ""
    page_size: 100
    max_page: 5
    request_interval: 1.0
    rate_limit_retry: 4
    rate_limit_backoff: 2
    rate_limit_max_sleep: 60
    enable: false
  hunter_how: # 网站 https://hunter.how/
    api_key: ""
    page_size: 100
    max_page: 5
    request_interval: 1.0
    rate_limit_retry: 4
    rate_limit_backoff: 2
    rate_limit_max_sleep: 60
    enable: false
  shodan: # 网站 https://www.shodan.io/
    api_key: ""
    max_page: 20
    request_interval: 1.0
    rate_limit_retry: 4
    rate_limit_backoff: 2
    rate_limit_max_sleep: 60
    enable: false
  passivetotal: # 请前往 https://community.riskiq.com/ 注册自己的key并替换
    auth_email: ""
    auth_key: ""
    enable: false
  quake_360: # 网站 https://quake.360.cn/
    quake_token: ""
    max_size: 500
    rate_limit_retry: 4
    rate_limit_backoff: 3
    rate_limit_max_sleep: 90
    enable: false
  rapiddns:
    enable: true
  securitytrails: # 网站 https://securitytrails.com/
    api_key: ""
    enable: false
  virustotal: # 网站 https://www.virustotal.com/gui/
    api_key: ""
    enable: false
  zoomeye:
    api_key: ""
    max_page: 20
    request_interval: 1.0
    rate_limit_retry: 4
    rate_limit_backoff: 2
    rate_limit_max_sleep: 60
    enable: false
  chaos:
    api_key: ""
    enable: false

#GeoIP 数据库文件配置项
GEOIP:
  CITY: '/data/GeoLite2/GeoLite2-City.mmdb'
  ASN: '/data/GeoLite2/GeoLite2-ASN.mmdb'


#Fofa API 配置项
FOFA:
  URL: "https://fofa.info"
  EMAIL: ""
  KEY: ""

#*** 监控任务消息推送配置 ****
#监控任务消息推送配置，支持钉钉，飞书，企业微信，邮件
#如果不需要推送，可以将所有配置项都留空
#文档：https://tophanttechnology.github.io/ARL-doc/config_option/?h=%E6%B6%88%E6%81%AF#_1
#钉钉消息推送配置
#钉钉添加机器人，请查看
#https://github.com/TophantTechnology/ARL/wiki/ARL%202.3%20%E6%96%B0%E6%B7%BB%E5%8A%A0%E5%8A%9F%E8%83%BD%E8%AF%B4%E6%98%8E
DINGDING:
  SECRET: ""
  ACCESS_TOKEN: ""

# 钉钉开放平台（知识库推送）配置（非群机器人）
# 用途：将任务结果发布到钉钉知识库
# 必填（仅当 ENABLE=true 时）：CORP_ID、APP_KEY、APP_SECRET、OPERATOR_ID、WORKSPACE_ID、PARENT_NODE_ID
# 建议：生产环境通过 ARL_DINGTALK_* 环境变量注入敏感字段（适配 K8s Secret）
DINGTALK_API:
  ENABLE: false # 是否启用知识库推送
  BASE_URL: "https://api.dingtalk.com" # 钉钉 OpenAPI 地址，通常不需要修改
  CORP_ID: "" # 必填：企业组织 ID（corpId）
  APP_KEY: "" # 必填：应用 AppKey（client_id）
  APP_SECRET: "" # 必填：应用 AppSecret（client_secret，敏感）
  OPERATOR_ID: "" # 必填：操作者 unionId（需具备目标知识库权限）
  WORKSPACE_ID: "" # 必填：知识库空间 ID
  PARENT_NODE_ID: "" # 必填：父节点 ID（可填 rootNodeId 或指定目录 nodeId）
  CREATE_NODE_PATH: "/v1.0/doc/workspaces/{workspace_id}/docs" # 创建知识库表格 API 路径，支持 {workspace_id}
  KB_TIMEOUT: 20 # 调用钉钉 API 的超时时间（秒）
  TITLE_PREFIX: "互联网资产自动化收集" # 文档标题前缀
  DRY_RUN: false # 演练模式：true 时只走流程不真正创建文档
  REPORT_BASE_URL: "" # 可选：报告访问基础地址，用于拼接外链
  SSL_CERT_NOTIFY_ENABLE: false # 是否启用SSL证书过期/临期机器人通知
  SSL_CERT_NOTIFY_DAYS: 30 # SSL证书提醒阈值（剩余天数 <= 该值时触发）

# AI 管理配置
# 用途：
# 1. 任务管理 -> AI 报告（Markdown）导出
# 2. 后续 AI 调度与误报复核能力（按规划灰度接入）
AI:
  ENABLE: true # AI 能力总开关（默认开启；未配置完整模型时自动降级，不报错）
  ACTIVE_MODEL_PROFILE_ID: "default_model" # 当前生效模型（运行期单次仅使用一个生效模型）
  MODEL_PROFILES:
    - id: "default_model"
      name: "默认模型"
      provider: "openai" # qwen / kimi / openai / glm / deepseek / custom_compatible
      base_url: "https://api.openai.com/v1"
      api_key: "" # 建议通过环境变量注入敏感信息
      model: "gpt-4o-mini"
      timeout_sec: 40
      temperature: 0.2
      max_tokens: 4000
  # 兼容字段：由当前生效模型自动同步，可不手动维护
  PROVIDER: "openai"
  CUSTOM_PROVIDER_NAME: "" # 当 PROVIDER=custom_compatible 时可填写别名
  BASE_URL: "https://api.openai.com/v1"
  API_KEY: ""
  MODEL: "gpt-4o-mini"
  TIMEOUT_SEC: 40
  TEMPERATURE: 0.2
  MAX_TOKENS: 4000
  DIALOG_SYSTEM_PROMPT: ""
  DIALOG_STYLE: "专业"
  DIALOG_LANGUAGE: "zh-CN"
  DIALOG_CONTEXT_MESSAGES: 8
  ACTIVE_PROMPT_ID: "default_ai_report"
  AI_POC_SCAN_ENABLE: true
  AI_DENOISE_ENABLE: true
  AI_DENOISE_MODULES:
    site: true
    fileleak: true
    cert: true
    url: true
    vuln: true
    nuclei_result: true
  AI_DENOISE_PROMPT_IDS:
    site: "default_ai_denoise_site"
    fileleak: "default_ai_denoise_fileleak"
    cert: "default_ai_denoise_cert"
    url: "default_ai_denoise_url"
    vuln: "default_ai_denoise_vuln"
    nuclei_result: "default_ai_denoise_poc"
  PROMPT_TEMPLATES:
    - id: "default_ai_report"
      name: "默认AI报告模板"
      scene: "ai_report_export"
      content: "你是互联网资产自动化收集系统的安全分析助手。请基于输入数据输出结构化研判：任务概览、关键资产、风险聚类、疑似误报、优先修复建议、复测建议。要求结论可执行、避免夸大风险、避免输出不存在的数据。"
      updated_at: ""
    - id: "default_fp_review"
      name: "默认误报复核模板"
      scene: "false_positive_review"
      content: "你是安全误报复核助手。请根据规则命中、上下文证据、影响面和可复现性进行评分，输出 pass/suspected_fp/manual_review 三档。"
      updated_at: ""
    - id: "default_ai_denoise_site"
      name: "默认AI去噪-站点"
      scene: "ai_denoise_site"
      content: "你是站点价值分析助手。请基于站点URL、标题、响应头、状态码与指纹信息，输出正常/可疑/危险结论，并给出AI研判后的指纹结果、证据与处置建议。"
      updated_at: ""
    - id: "default_ai_denoise_fileleak"
      name: "默认AI去噪-目录扫描"
      scene: "ai_denoise_fileleak"
      content: "你是目录扫描去噪助手。请基于URL路径、状态码、标题和返回体长度，输出风险结论：正常/可疑/危险。必须给出证据要点与修复建议，避免夸大。"
      updated_at: ""
    - id: "default_ai_denoise_cert"
      name: "默认AI去噪-SSL证书"
      scene: "ai_denoise_cert"
      content: "你是证书安全分析助手。请基于证书有效期、签发信息、协议与套件特征，给出证书安全结论，并输出到期风险依据与处置建议。"
      updated_at: ""
    - id: "default_ai_denoise_url"
      name: "默认AI去噪-URL信息"
      scene: "ai_denoise_url"
      content: "你是URL风险去噪助手。请基于URL路径、状态码、标题和上下文，输出安全/可疑/危险结论，并给出依据与建议。"
      updated_at: ""
    - id: "default_ai_denoise_vuln"
      name: "默认AI去噪-风险"
      scene: "ai_denoise_vuln"
      content: "你是漏洞误报复核助手。请根据风险等级、目标、验证证据与规则上下文，判断可信或疑似误报，并输出处置建议。"
      updated_at: ""
    - id: "default_ai_denoise_poc"
      name: "默认AI去噪-PoC风险"
      scene: "ai_denoise_nuclei_result"
      content: "你是PoC风险复核助手。请结合扫描器、规则ID、风险等级、命中URL与验证信息判断可信度，识别疑似误报并给出复测建议。"
      updated_at: ""
  CUSTOM_COMPAT_PROVIDERS: [] # 可添加 OpenAI 兼容网关列表


#飞书消息推送配置, 需要设置签名校验
#https://open.feishu.cn/document/client-docs/bot-v3/add-custom-bot
FEISHU:
  WEBHOOK_URL: ""
  SECRET: ""


#企业微信消息推送配置
#https://open.work.weixin.qq.com/help2/pc/14931
WXWORK:
  WEBHOOK_URL: ""


#邮件发送配置
EMAIL:
  HOST: ""
  PORT: ""
  USERNAME: ""
  PASSWORD: ""
  TO: ""

# 监控任务 WEBHOOK 配置
# IP/域名监控和站点监控结束后会往下面的URL POST提交JSON数据
# 为了验证身份会在Header中带上Token 字段
WEBHOOK:
  URL: ""
  TOKEN: ""


#GITHUB 搜索 TOKEN
GITHUB:
  TOKEN: ""

#代理配置项，如"http://127.0.0.1:8080", 端口扫描不会走代理
PROXY:
  HTTP_URL: ""

ARL:
  AUTH: true
  #API 认证key, 可以访问api/doc查看文档
  API_KEY: ""
  BLACK_IPS:
    - 127.0.0.0/8
    - 0.0.0.0/8
    - 172.16.0.0/12
    - 100.64.0.0/10
    #- 10.0.0.0/8
    #- 192.168.0.0/16
  # 指定域名解析器（为空时使用系统默认DNS）
  DNS_RESOLVERS:
    - 114.114.114.114
    - 8.8.8.8
  # 截图引擎：playwright / phantomjs / auto
  SCREENSHOT_ENGINE: "playwright"
  # Playwright 导航超时（毫秒）
  PLAYWRIGHT_TIMEOUT_MS: 15000
  # Playwright 截图前等待（毫秒）
  PLAYWRIGHT_WAIT_MS: 1000
  # 可选：自定义 Chromium 可执行路径（为空使用 Playwright 内置浏览器）
  PLAYWRIGHT_CHROMIUM_BIN: ""
  # PhantomJS 可执行文件路径（legacy 兼容可选）
  # PHANTOMJS_BIN: "/opt/ARL/app/tools/phantomjs"
  # PhantomJS 单站点截图超时（秒）
  PHANTOMJS_TIMEOUT_SEC: 30
  # worker 截图回传 web（默认开启，未配置地址时自动降级）
  SCREENSHOT_SYNC_ENABLE: true
  # web 内部上传接口地址（K8s 示例：https://arl-web）
  SCREENSHOT_SYNC_WEB_URL: ""
  # 单次回传超时（秒）
  SCREENSHOT_SYNC_TIMEOUT: 10
  # 单张截图最大字节数（默认 2MB）
  SCREENSHOT_SYNC_MAX_SIZE: 2097152
  # Nuclei 可执行文件路径（可选），默认使用系统 PATH 中的 nuclei
  # NUCLEI_BIN: "/usr/bin/nuclei"
  # Nuclei 模板目录（建议指定为内部维护模板库）
  # 默认优先使用项目根目录 tools/nuclei-templates（Docker 常见路径：/code/tools/nuclei-templates）
  # NUCLEI_TEMPLATE_DIR: "/code/tools/nuclei/nuclei-templates"
  # 单次 nuclei 子进程超时（秒），超时后当前批次跳过继续后续流程
  NUCLEI_EXEC_TIMEOUT_SEC: 3600
  # nuclei 阶段总预算（秒，0=不限制）
  NUCLEI_STAGE_TIMEOUT_SEC: 7200
  # nuclei 阶段最多扫描目标数（0=不限制）
  NUCLEI_STAGE_MAX_TARGETS: 0
  # 单目标 nuclei 最大扫描时长（秒）
  NUCLEI_SINGLE_TARGET_TIMEOUT_SEC: 900
  # 每批次最多目标数（<=1 表示自动分批，>1 表示固定分批大小）
  NUCLEI_TARGETS_PER_BATCH: 1
  # nuclei 每秒请求上限（RPS），用于限制带宽占用
  NUCLEI_RATE_LIMIT: 50
  # nuclei 并发 worker
  NUCLEI_CONCURRENCY: 24
  # nuclei bulk-size（单模板并行目标数）
  NUCLEI_BULK_SIZE: 30
  # 指纹未命中标签时是否启用 nuclei 自动扫描（-as）
  NUCLEI_AUTO_SCAN: true
  # 指纹未命中标签时的兜底标签（逗号分隔）
  NUCLEI_DEFAULT_TAGS: "cve"
  # afrog 可执行文件路径（默认使用 tools/afrog/afrog）
  AFROG_BIN: "/code/tools/afrog/afrog"
  # afrog PoC 目录（默认使用 tools/afrog/afrog-pocs）
  AFROG_POCS_DIR: "/code/tools/afrog/afrog-pocs"
  # afrog 模糊搜索关键词（逗号分隔，为空表示不过滤）
  AFROG_SEARCH_KEYWORDS: ""
  # afrog 严重级别过滤（info/low/medium/high/critical，逗号分隔）
  AFROG_SEVERITY: ""
  # afrog 模板并发（命令行 -c）
  AFROG_CONCURRENCY: 30
  # afrog 每秒请求上限（命令行 -rl）
  AFROG_RATE_LIMIT: 30
  # afrog 扫描超时（秒）
  AFROG_EXEC_TIMEOUT_SEC: 1800
  # afrog 单批最多目标数
  AFROG_TARGETS_PER_BATCH: 50
  # afrog 阶段总预算（秒，0=不限制）
  AFROG_STAGE_TIMEOUT_SEC: 3600
  # afrog 阶段最多扫描目标数（0=不限制）
  AFROG_STAGE_MAX_TARGETS: 0
  # 公网A记录IP反查增强：按IP调用三方API补充同域资产（默认开启）
  IP_PIVOT_QUERY_ENABLE: true
  # 单任务最多参与反查的IP数量
  IP_PIVOT_QUERY_MAX_IPS: 20
  # 单任务最多接收反查新增域名数量
  IP_PIVOT_QUERY_MAX_DOMAINS: 200
  # 仅保留当前任务主域范围内的反查结果
  IP_PIVOT_QUERY_REQUIRE_SCOPE: true
  # 反查前跳过已识别为CDN/WAF的IP
  IP_PIVOT_QUERY_SKIP_CDN: true
  # 证书反查增强：证书命中目标域后，按 cert.sn/cert.sha-1 调用三方API（默认开启）
  CERT_PIVOT_QUERY_ENABLE: true
  # 单任务最多参与反查的证书数量
  CERT_PIVOT_QUERY_MAX_CERTS: 20
  # 单任务最多接收反查新增域名数量
  CERT_PIVOT_QUERY_MAX_DOMAINS: 200
  # 仅保留当前任务主域范围内的反查结果
  CERT_PIVOT_QUERY_REQUIRE_SCOPE: true
  # 反查前跳过已识别为CDN/WAF的证书来源IP
  CERT_PIVOT_QUERY_SKIP_CDN: true
  # 单个 IP:Port 最多尝试的 SNI 域名数量（0=仅扫描默认证书）
  CERT_MULTI_SNI_MAX_PER_ENDPOINT: 3
  # SSL 证书抓取分批大小（按 endpoint+SNI 展开后目标数）
  SSL_CERT_FETCH_TARGET_BATCH_SIZE: 120
  # SSL 证书抓取单批并发
  SSL_CERT_FETCH_CONCURRENCY: 15
  # SSL 证书阶段超时预算基础值（秒，0=不限制）
  SSL_CERT_STAGE_TIMEOUT_SEC: 1500
  # SSL 证书阶段超时预算：每个展开目标额外追加（秒）
  SSL_CERT_STAGE_TIMEOUT_PER_TARGET_SEC: 3
  # SSL 证书阶段超时预算上限（秒，0=不限制）
  SSL_CERT_STAGE_TIMEOUT_MAX_SEC: 3600
  # 域名插件查询阶段每批来源数
  DOMAIN_DNS_QUERY_PLUGIN_SOURCE_BATCH_SIZE: 4
  # 域名插件查询阶段超时预算基础值（秒，0=不限制）
  DNS_QUERY_PLUGIN_STAGE_TIMEOUT_SEC: 900
  # 域名插件查询阶段超时预算：每个来源额外追加（秒）
  DNS_QUERY_PLUGIN_STAGE_TIMEOUT_PER_SOURCE_SEC: 45
  # 域名插件查询阶段超时预算上限（秒，0=不限制）
  DNS_QUERY_PLUGIN_STAGE_TIMEOUT_MAX_SEC: 1800
  # 指纹到 nuclei 标签映射（可按内部资产特征扩充）
  NUCLEI_FINGER_TAG_MAP:
    wordpress:
      - wordpress
    drupal:
      - drupal
    jenkins:
      - jenkins
  # 启用内建 kscan 指纹（无需单独导入命令）
  KSCAN_FINGERPRINT_ENABLE: true
  # kscan 指纹文件路径（默认可不填，使用 app/dicts/kscan_fingerprint.json；也可改为本地生成的单文件合并库）
  # KSCAN_FINGERPRINT_FILE: "/code/app/dicts/kscan_fingerprint.json"
  # KSCAN_FINGERPRINT_FILE: "/code/app/dicts/kscan_fingerprint.local.json"
  # 是否给 kscan 指纹名称加前缀（默认空）
  KSCAN_FINGERPRINT_NAME_PREFIX: ""
  # 正则(~=)回退策略：none / literal
  KSCAN_FINGERPRINT_REGEX_FALLBACK: "literal"
  # literal 回退最小长度
  KSCAN_FINGERPRINT_MIN_LITERAL_LEN: 5
  # 单指纹名称最大规则数
  KSCAN_FINGERPRINT_MAX_RULES_PER_NAME: 30
  # 最大导入规则总数（0=不限制）
  KSCAN_FINGERPRINT_MAX_TOTAL_RULES: 12000
  ## 禁止域名，不可为空数组
  FORBIDDEN_DOMAINS:
    - edu.cn
    - org.cn
    - gov.cn
  #端口对应前端测试选项
  PORT_TOP_10: "80,443,8443,8080,8081,8888,8089,5000,5001,8085,800,81,9000,88,8001,8090"
  # nmap 主机超时策略：default=按扫描模式自动估算，custom=使用 HOST_TIMEOUT 固定值
  HOST_TIMEOUT_TYPE: "default"
  # nmap 主机超时（秒，仅 HOST_TIMEOUT_TYPE=custom 时生效）
  HOST_TIMEOUT: 1500
  # nmap 探测报文并行度默认值
  PORT_PARALLELISM: 64
  # nmap 最少发包速率默认值
  PORT_MIN_RATE: 260
  # 端口扫描分片：常规模式每批目标数
  PORT_SCAN_TARGET_BATCH_SIZE: 48
  # 端口扫描分片：重负载端口集每批目标数
  PORT_SCAN_HEAVY_TARGET_BATCH_SIZE: 16
  # 端口扫描分片：全端口每批目标数
  PORT_SCAN_ALL_TARGET_BATCH_SIZE: 4
  # 两阶段精扫单主机端口分段大小（仅分段，不裁剪结果）
  PORT_SCAN_STAGE2_PORT_CHUNK_SIZE: 300
  # 端口扫描阶段超时预算基础值（秒，0=不限制）
  PORT_SCAN_STAGE_TIMEOUT_SEC: 900
  # 端口扫描阶段超时预算：每个目标额外追加（秒）
  PORT_SCAN_STAGE_TIMEOUT_PER_TARGET_SEC: 90
  # 端口扫描阶段超时预算：每 1000 个端口额外追加（秒）
  PORT_SCAN_STAGE_TIMEOUT_PER_1000_PORTS_SEC: 120
  # 端口扫描阶段超时预算上限（秒，0=不限制）
  PORT_SCAN_STAGE_TIMEOUT_MAX_SEC: 3600
  # 重任务队列分流阈值：端口数
  TASK_HEAVY_PORT_THRESHOLD: 1000
  # 重任务队列分流阈值：服务识别端口数
  TASK_HEAVY_SERVICE_PORT_THRESHOLD: 500
  # 重任务队列分流阈值：目标数
  TASK_HEAVY_TARGET_THRESHOLD: 24
  # 是否启用重任务队列分流；若未检测到 arlheavy 消费者会自动回退到 arltask
  TASK_HEAVY_QUEUE_ENABLE: true
  #域名爆破字典前端大字典选项，空即系统默认
  DOMAIN_DICT: ""
  #文件泄漏字典， 空即系统默认
  FILE_LEAK_DICT: ""
  # 单站点目录扫描线程数
  FILE_LEAK_CONCURRENCY: 6
  # 目录扫描目标并发（并行扫描多个站点）
  FILE_LEAK_TARGET_CONCURRENCY: 1
  # 单站点目录扫描总超时（秒）
  FILE_LEAK_SITE_TIMEOUT_SEC: 900
  # 单站点目录扫描总超时每1000 URL追加预算（秒）
  FILE_LEAK_SITE_TIMEOUT_PER_1000_URLS_SEC: 180
  # 单站点目录扫描总超时预算上限（秒，0=不限制）
  FILE_LEAK_SITE_TIMEOUT_MAX_SEC: 7200
  # 单站点目录扫描无进展超时（秒）
  FILE_LEAK_NO_PROGRESS_TIMEOUT_SEC: 120
  # 单站点目录扫描无进展超时每1000 URL追加预算（秒）
  FILE_LEAK_NO_PROGRESS_TIMEOUT_PER_1000_URLS_SEC: 30
  # 单站点目录扫描无进展超时预算上限（秒，0=不限制）
  FILE_LEAK_NO_PROGRESS_TIMEOUT_MAX_SEC: 600
  # WIH 可执行文件路径（默认固定使用镜像内源码编译产物，避免被共享 tools 目录中的旧版覆盖）
  WIH_BIN_PATH: "/usr/bin/wih"
  # WIH 规则文件路径（默认使用镜像内只读副本，避免被共享 tools 目录中的旧规则覆盖）
  WIH_RULE_PATH: "/usr/local/share/arl/wih/config/rules.yml"
  # WIH 扫描超时（秒）
  WIH_TIMEOUT_SEC: 7200
  # WIH 全局并发（若 wih 二进制支持 --concurrency / -c）
  WIH_CONCURRENCY: 6
  # WIH 单站点并发（若 wih 二进制支持 --concurrency-per-site）
  WIH_CONCURRENCY_PER_SITE: 2
  # WIH 单批最大站点数，避免超时后把大批次整批重跑
  WIH_MAX_BATCH_SIZE: 12
  # 是否启用 WIH 运行时采集
  WIH_RUNTIME_ENABLE: true
  # WIH 运行时驱动：playwright / external / noop
  WIH_RUNTIME_DRIVER: "playwright"
  # WIH 运行时自定义命令（external 为完整命令；playwright 可覆盖默认 node 调用）
  WIH_RUNTIME_COMMAND: ""
  # WIH 运行时超时（秒）
  WIH_RUNTIME_TIMEOUT_SEC: 60
  # WIH 运行时最大页面数
  WIH_RUNTIME_MAX_PAGES: 12
  # WIH 运行时最大交互动作数
  WIH_RUNTIME_MAX_ACTIONS: 32
  # WIH 运行时最大请求采集数
  WIH_RUNTIME_MAX_REQUESTS: 180
  # TruffleHog 可执行文件路径（建议指向 tools/TruffleHog/trufflehog）
  TRUFFLEHOG_BIN: ""
  # 是否启用 TruffleHog JS 二次扫描
  TRUFFLEHOG_ENABLE: true
  # 是否禁用在线验证（默认 true，避免外连验证）
  TRUFFLEHOG_NO_VERIFICATION: true
  # TruffleHog 结果类型过滤
  TRUFFLEHOG_RESULTS: "verified,unknown,unverified"
  # 单次任务最多扫描 JS 文件数
  TRUFFLEHOG_JS_MAX_FILES: 80
  # 单次 TruffleHog 扫描超时（秒）
  TRUFFLEHOG_JS_TIMEOUT_SEC: 900
  # 单个 JS 文件下载大小上限（字节）
  TRUFFLEHOG_JS_MAX_FILE_BYTES: 524288
  # 是否启用 URLFinder 同目标 URL/HTML/JS 二次敏感扫描（复用 WIH）
  URLFINDER_SENSITIVE_ENABLE: true
  # URLFinder 二次敏感扫描单次最多目标数
  URLFINDER_SENSITIVE_MAX_TARGETS: 300
  # URLFinder 二次敏感扫描是否包含 JS 目标
  URLFINDER_SENSITIVE_INCLUDE_JS: true
  # URLFinder 二次敏感扫描单批 WIH 超时（秒）
  URLFINDER_SENSITIVE_WIH_TIMEOUT_SEC: 600
  # URLFinder 二次敏感扫描阶段总预算（秒，0=不限制）
  URLFINDER_SENSITIVE_STAGE_TIMEOUT_SEC: 1800
  # 是否启用 URLFinder URL 可达性探测并写入 URL 信息
  URLFINDER_URL_PROBE_ENABLE: true
  # URLFinder URL 可达性探测单次最多目标数
  URLFINDER_URL_PROBE_MAX_TARGETS: 800
  # URLFinder URL 可达性探测并发
  URLFINDER_URL_PROBE_CONCURRENCY: 20

  # Web Gunicorn worker 数（默认按高性能预设）
  WEB_GUNICORN_WORKERS: 6
  # Celery 主任务队列并发
  CELERY_TASK_WORKER_CONCURRENCY: 3
  # Celery GitHub 队列并发
  CELERY_GITHUB_WORKER_CONCURRENCY: 2
  # Celery 重任务队列并发（全端口/深度识别）
  CELERY_HEAVY_WORKER_CONCURRENCY: 3
  # Celery Web 重任务队列并发（目录扫描/PoC/截图/站点爬虫）
  CELERY_WEB_WORKER_CONCURRENCY: 3
  # Celery 预取倍率（建议保持 1）
  CELERY_PREFETCH_MULTIPLIER: 1
  # Celery 子进程处理多少任务后重启（防止内存膨胀）
  CELERY_MAX_TASKS_PER_CHILD: 32
  # Celery 子进程内存上限（KB），超过后重启
  CELERY_MAX_MEMORY_PER_CHILD: 720000
  # Celery 单任务硬超时（秒，0=不限制）
  CELERY_TASK_TIME_LIMIT_SEC: 0
  # Celery 单任务软超时（秒，0=不限制）
  CELERY_TASK_SOFT_TIME_LIMIT_SEC: 0

  # 域名爆破并发数
  DOMAIN_BRUTE_CONCURRENT: 360
  # 组合生成的域名爆破并发数
  ALT_DNS_CONCURRENT: 1400
  # 域名解析并发
  DOMAIN_RESOLVE_CONCURRENCY: 10
  # 域名信息构建并发
  DOMAIN_INFO_CONCURRENCY: 10
  # HTTP可用性检查并发
  HTTP_CHECK_CONCURRENCY: 10
  # 站点抓取并发
  HTTP_FETCH_SITE_CONCURRENCY: 8
  # 站点探测并发
  PROBE_HTTP_CONCURRENCY: 8
  # 站点截图并发
  SITE_SCREENSHOT_CONCURRENCY: 4
  # NPoC 服务识别并发
  NPOC_SNIFFER_CONCURRENCY: 8
  # NPoC PoC 扫描并发
  NPOC_POC_CONCURRENCY: 6
  # NPoC 弱口令并发
  NPOC_BRUTE_CONCURRENCY: 4
  # 资产站点监控并发
  ASSET_SITE_MONITOR_CONCURRENCY: 8
  # 资产站点发现并发
  ASSET_SITE_DISCOVERY_CONCURRENCY: 10
