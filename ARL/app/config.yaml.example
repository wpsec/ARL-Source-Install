
CELERY:
  BROKER_URL : "amqp://arl:arlpassword@localhost:5672/arlv2host"


MONGO:
  URI : 'mongodb://127.0.0.1:27017/'
  DB : 'arl'



# 利用三方API进行域名收集
# 测试命令 python3 -m test.test_query_plugin [source1] [source2]
# 域名查询插件配置, enable 字段可以单独控制是否启用该插件，如果没有这个字段也会默认启用
QUERY_PLUGIN:
  alienvault:
    enable: true
  certspotter: # https://www.certspotter.com/
    after_id: 1
    max_page: 3
    enable: true
  crtsh:
    enable: true
  fofa:  # fofa 的key配置在上面
    enable: true
  hunter_qax: # 网站 https://hunter.qianxin.com/
    api_key: ""
    page_size: 100
    max_page: 5
    request_interval: 1.0
    rate_limit_retry: 4
    rate_limit_backoff: 2
    rate_limit_max_sleep: 60
    enable: false
  passivetotal: # 请前往 https://community.riskiq.com/ 注册自己的key并替换
    auth_email: ""
    auth_key: ""
    enable: false
  quake_360: # 网站 https://quake.360.cn/
    quake_token: ""
    max_size: 500
    rate_limit_retry: 4
    rate_limit_backoff: 3
    rate_limit_max_sleep: 90
    enable: false
  rapiddns:
    enable: true
  securitytrails: # 网站 https://securitytrails.com/
    api_key: ""
    enable: false
  virustotal: # 网站 https://www.virustotal.com/gui/
    api_key: ""
    enable: false
  zoomeye:
    api_key: ""
    max_page: 20
    request_interval: 1.0
    rate_limit_retry: 4
    rate_limit_backoff: 2
    rate_limit_max_sleep: 60
    enable: false
  chaos:
    api_key: ""
    enable: false

#GeoIP 数据库文件配置项
GEOIP:
  CITY: '/data/GeoLite2/GeoLite2-City.mmdb'
  ASN: '/data/GeoLite2/GeoLite2-ASN.mmdb'


#Fofa API 配置项
FOFA:
  URL: "https://fofa.info"
  EMAIL: ""
  KEY: ""

#*** 监控任务消息推送配置 ****
#监控任务消息推送配置，支持钉钉，飞书，企业微信，邮件
#如果不需要推送，可以将所有配置项都留空
#文档：https://tophanttechnology.github.io/ARL-doc/config_option/?h=%E6%B6%88%E6%81%AF#_1
#钉钉消息推送配置
#钉钉添加机器人，请查看
#https://github.com/TophantTechnology/ARL/wiki/ARL%202.3%20%E6%96%B0%E6%B7%BB%E5%8A%A0%E5%8A%9F%E8%83%BD%E8%AF%B4%E6%98%8E
DINGDING:
  SECRET: ""
  ACCESS_TOKEN: ""

# 钉钉开放平台（知识库推送）配置（非群机器人）
# 用途：将任务结果发布到钉钉知识库
# 必填（仅当 ENABLE=true 时）：CORP_ID、APP_KEY、APP_SECRET、OPERATOR_ID、WORKSPACE_ID、PARENT_NODE_ID
# 建议：生产环境通过 ARL_DINGTALK_* 环境变量注入敏感字段（适配 K8s Secret）
DINGTALK_API:
  ENABLE: false # 是否启用知识库推送
  BASE_URL: "https://api.dingtalk.com" # 钉钉 OpenAPI 地址，通常不需要修改
  CORP_ID: "" # 必填：企业组织 ID（corpId）
  APP_KEY: "" # 必填：应用 AppKey（client_id）
  APP_SECRET: "" # 必填：应用 AppSecret（client_secret，敏感）
  OPERATOR_ID: "" # 必填：操作者 unionId（需具备目标知识库权限）
  WORKSPACE_ID: "" # 必填：知识库空间 ID
  PARENT_NODE_ID: "" # 必填：父节点 ID（可填 rootNodeId 或指定目录 nodeId）
  CREATE_NODE_PATH: "/v1.0/doc/workspaces/{workspace_id}/docs" # 创建知识库表格 API 路径，支持 {workspace_id}
  KB_TIMEOUT: 20 # 调用钉钉 API 的超时时间（秒）
  TITLE_PREFIX: "互联网资产自动化收集" # 文档标题前缀
  DRY_RUN: false # 演练模式：true 时只走流程不真正创建文档
  REPORT_BASE_URL: "" # 可选：报告访问基础地址，用于拼接外链


#飞书消息推送配置, 需要设置签名校验
#https://open.feishu.cn/document/client-docs/bot-v3/add-custom-bot
FEISHU:
  WEBHOOK_URL: ""
  SECRET: ""


#企业微信消息推送配置
#https://open.work.weixin.qq.com/help2/pc/14931
WXWORK:
  WEBHOOK_URL: ""


#邮件发送配置
EMAIL:
  HOST: ""
  PORT: ""
  USERNAME: ""
  PASSWORD: ""
  TO: ""

# 监控任务 WEBHOOK 配置
# IP/域名监控和站点监控结束后会往下面的URL POST提交JSON数据
# 为了验证身份会在Header中带上Token 字段
WEBHOOK:
  URL: ""
  TOKEN: ""


#GITHUB 搜索 TOKEN
GITHUB:
  TOKEN: ""

#代理配置项，如"http://127.0.0.1:8080", 端口扫描不会走代理
PROXY:
  HTTP_URL: ""

ARL:
  AUTH: true
  #API 认证key, 可以访问api/doc查看文档
  API_KEY: ""
  BLACK_IPS:
    - 127.0.0.0/8
    - 0.0.0.0/8
    - 172.16.0.0/12
    - 100.64.0.0/10
    #- 10.0.0.0/8
    #- 192.168.0.0/16
  # 指定域名解析器（为空时使用系统默认DNS）
  DNS_RESOLVERS:
    - 114.114.114.114
    - 8.8.8.8
  # 截图引擎：playwright / phantomjs / auto
  SCREENSHOT_ENGINE: "playwright"
  # Playwright 导航超时（毫秒）
  PLAYWRIGHT_TIMEOUT_MS: 15000
  # Playwright 截图前等待（毫秒）
  PLAYWRIGHT_WAIT_MS: 1000
  # 可选：自定义 Chromium 可执行路径（为空使用 Playwright 内置浏览器）
  PLAYWRIGHT_CHROMIUM_BIN: ""
  # PhantomJS 可执行文件路径（legacy 兼容可选）
  # PHANTOMJS_BIN: "/opt/ARL/app/tools/phantomjs"
  # worker 截图回传 web（默认开启，未配置地址时自动降级）
  SCREENSHOT_SYNC_ENABLE: true
  # web 内部上传接口地址（K8s 示例：https://arl-web）
  SCREENSHOT_SYNC_WEB_URL: ""
  # 单次回传超时（秒）
  SCREENSHOT_SYNC_TIMEOUT: 10
  # 单张截图最大字节数（默认 2MB）
  SCREENSHOT_SYNC_MAX_SIZE: 2097152
  # Nuclei 可执行文件路径（可选），默认使用系统 PATH 中的 nuclei
  # NUCLEI_BIN: "/usr/bin/nuclei"
  # Nuclei 模板目录（建议指定为内部维护模板库）
  # 默认优先使用项目根目录 tools/nuclei-templates（Docker 常见路径：/code/tools/nuclei-templates）
  # NUCLEI_TEMPLATE_DIR: "/code/tools/nuclei-templates"
  # 指纹未命中标签时是否启用 nuclei 自动扫描（-as）
  NUCLEI_AUTO_SCAN: true
  # 指纹未命中标签时的兜底标签（逗号分隔）
  NUCLEI_DEFAULT_TAGS: "cve"
  # 公网A记录IP反查增强：按IP调用三方API补充同域资产（默认开启）
  IP_PIVOT_QUERY_ENABLE: true
  # 单任务最多参与反查的IP数量
  IP_PIVOT_QUERY_MAX_IPS: 20
  # 单任务最多接收反查新增域名数量
  IP_PIVOT_QUERY_MAX_DOMAINS: 200
  # 仅保留当前任务主域范围内的反查结果
  IP_PIVOT_QUERY_REQUIRE_SCOPE: true
  # 反查前跳过已识别为CDN/WAF的IP
  IP_PIVOT_QUERY_SKIP_CDN: true
  # 证书反查增强：证书命中目标域后，按 cert.sn/cert.sha-1 调用三方API（默认开启）
  CERT_PIVOT_QUERY_ENABLE: true
  # 单任务最多参与反查的证书数量
  CERT_PIVOT_QUERY_MAX_CERTS: 20
  # 单任务最多接收反查新增域名数量
  CERT_PIVOT_QUERY_MAX_DOMAINS: 200
  # 仅保留当前任务主域范围内的反查结果
  CERT_PIVOT_QUERY_REQUIRE_SCOPE: true
  # 反查前跳过已识别为CDN/WAF的证书来源IP
  CERT_PIVOT_QUERY_SKIP_CDN: true
  # 指纹到 nuclei 标签映射（可按内部资产特征扩充）
  NUCLEI_FINGER_TAG_MAP:
    wordpress:
      - wordpress
    drupal:
      - drupal
    jenkins:
      - jenkins
  # 启用内建 kscan 指纹（无需单独导入命令）
  KSCAN_FINGERPRINT_ENABLE: true
  # kscan 指纹文件路径（默认可不填，使用 app/dicts/kscan_fingerprint.json）
  # KSCAN_FINGERPRINT_FILE: "/code/app/dicts/kscan_fingerprint.json"
  # 是否给 kscan 指纹名称加前缀（默认空）
  KSCAN_FINGERPRINT_NAME_PREFIX: ""
  # 正则(~=)回退策略：none / literal
  KSCAN_FINGERPRINT_REGEX_FALLBACK: "literal"
  # literal 回退最小长度
  KSCAN_FINGERPRINT_MIN_LITERAL_LEN: 5
  # 单指纹名称最大规则数
  KSCAN_FINGERPRINT_MAX_RULES_PER_NAME: 30
  # 最大导入规则总数（0=不限制）
  KSCAN_FINGERPRINT_MAX_TOTAL_RULES: 12000
  ## 禁止域名，不可为空数组
  FORBIDDEN_DOMAINS:
    - edu.cn
    - org.cn
    - gov.cn
  #端口对应前端测试选项
  PORT_TOP_10: "80,443,8443,8080,8081,8888,8089,5000,5001,8085,800,81,9000,88,8001,8090"
  #域名爆破字典前端大字典选项，空即系统默认
  DOMAIN_DICT: ""
  #文件泄漏字典， 空即系统默认
  FILE_LEAK_DICT: ""

  # Web Gunicorn worker 数（默认2，低内存环境建议 1~2）
  WEB_GUNICORN_WORKERS: 2
  # Celery 主任务队列并发
  CELERY_TASK_WORKER_CONCURRENCY: 2
  # Celery GitHub 队列并发
  CELERY_GITHUB_WORKER_CONCURRENCY: 1
  # Celery 预取倍率（建议保持 1）
  CELERY_PREFETCH_MULTIPLIER: 1
  # Celery 子进程处理多少任务后重启（防止内存膨胀）
  CELERY_MAX_TASKS_PER_CHILD: 20
  # Celery 子进程内存上限（KB），超过后重启
  CELERY_MAX_MEMORY_PER_CHILD: 280000

  # 域名爆破并发数
  DOMAIN_BRUTE_CONCURRENT: 180
  # 组合生成的域名爆破并发数
  ALT_DNS_CONCURRENT: 800
  # 域名解析并发
  DOMAIN_RESOLVE_CONCURRENCY: 10
  # 域名信息构建并发
  DOMAIN_INFO_CONCURRENCY: 10
  # HTTP可用性检查并发
  HTTP_CHECK_CONCURRENCY: 10
  # 站点抓取并发
  HTTP_FETCH_SITE_CONCURRENCY: 8
  # 站点探测并发
  PROBE_HTTP_CONCURRENCY: 8
  # 站点截图并发
  SITE_SCREENSHOT_CONCURRENCY: 4
  # NPoC 服务识别并发
  NPOC_SNIFFER_CONCURRENCY: 8
  # NPoC PoC 扫描并发
  NPOC_POC_CONCURRENCY: 6
  # NPoC 弱口令并发
  NPOC_BRUTE_CONCURRENCY: 4
  # 资产站点监控并发
  ASSET_SITE_MONITOR_CONCURRENCY: 8
  # 资产站点发现并发
  ASSET_SITE_DISCOVERY_CONCURRENCY: 10
