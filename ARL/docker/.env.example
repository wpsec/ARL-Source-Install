# 复制为 .env 并填入真实值；.env 不入库（仅本地存在，Git 已忽略）。
# 应用启动与 mongo-init.js 共用，三处必须一致。
#
# 首次安装可直接运行 ./start.sh（或 bash init-deploy-env.sh）：
#   - [自动生成] Mongo/RabbitMQ 内部凭据键由脚本随机生成并持久化，
#     已存在的值不会被覆盖（幂等，可重复执行）；
#   - [用户填写] Basic Auth 与 ARL 应用密码不做复杂度强制，只要求非空、
#     不能保留 <set-me> 占位（check-deploy-env.sh 预检把关）。
# 注意：值行不要写行尾注释——env-file 各解析层对 inline comment 语义不一致。

# [自动生成]
MONGO_INITDB_ROOT_USERNAME=<set-me>
# [自动生成]
MONGO_INITDB_ROOT_PASSWORD=<set-me>
# [用户填写] 应用登录名，可改（mongo-init.js 首次初始化写入）
ARL_APP_USERNAME=admin
# [用户填写] 应用登录密码
ARL_APP_PASSWORD=<set-me>
# [自动生成]
RABBITMQ_DEFAULT_USER=<set-me>
# [自动生成]
RABBITMQ_DEFAULT_PASS=<set-me>

NGINX_LISTEN_PORT=80
BASIC_AUTH_USERNAME=admin
# [用户填写]
BASIC_AUTH_PASSWORD=<set-me>
