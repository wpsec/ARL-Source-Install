# 复制为 .env；.env 不入库（仅本地存在，Git 已忽略）。
# 直接执行 docker compose 时，必须把所有 <set-me> 替换为真实值。
# 从仓库根目录执行 ./start.sh 时，脚本会先补齐本文件中的 Mongo/RabbitMQ
# 内部随机凭据，并交互要求填写 Basic Auth 与 ARL 应用密码；已有凭据不会覆盖。
# 应用启动与 mongo-init.js 共用，三处必须一致。
#
# 首次安装可直接运行 ./start.sh（或 bash init-deploy-env.sh）：
#   - [自动生成] Mongo/RabbitMQ 内部凭据键由脚本随机生成并持久化，
#     已存在的值不会被覆盖（幂等，可重复执行）；
#   - [用户填写] Basic Auth 与 ARL 应用密码不做复杂度强制，只要求非空、
#     不能保留 <set-me> 占位（check-deploy-env.sh 预检把关）。
# 注意：值行不要写行尾注释——env-file 各解析层对 inline comment 语义不一致。

# [自动生成]
MONGO_INITDB_ROOT_USERNAME=<set-me>
# [自动生成]
MONGO_INITDB_ROOT_PASSWORD=<set-me>
# [用户填写] 应用登录名，可改（mongo-init.js 首次初始化写入）
ARL_APP_USERNAME=admin
# [用户填写] 应用登录密码
ARL_APP_PASSWORD=<set-me>
# [自动生成]
RABBITMQ_DEFAULT_USER=<set-me>
# [自动生成]
RABBITMQ_DEFAULT_PASS=<set-me>

# [可选] Nginx 监听端口，默认 80
NGINX_LISTEN_PORT=80
# [可选] Basic Auth 用户名，默认 admin
BASIC_AUTH_USERNAME=admin
# [用户填写]
BASIC_AUTH_PASSWORD=<set-me>

# [可选] Worker 副本数，仅支持 1 或 2，默认 2
ARL_WORKER_REPLICAS=2

# [可选] 计划 6 发布验收开关；生产默认关闭，按附录 E 临时覆盖
ARL_API_UNIFIED_ENABLE=false
ARL_API_UNIFIED_FALLBACK_ENABLE=true
ARL_RUST_ACCEL_API_UNIFIED_MODE=shadow
ARL_RUST_ACCEL_API_UNIFIED_RUST_STAGES=unified_normalize,unified_method
